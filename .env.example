# Copy to .env.local and fill values (never commit .env.local)

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chat and recommendations use stored reference data. No external AI key is required.

# Enable only after DB ownership/RLS review. Defaults to disabled.
QUOTE_WORKFLOW_ENABLED=false

# Optional — Kakao channel CTA (set on Vercel Production/Preview)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 사이트맵/메타데이터에 쓰이는 프로덕션 도메인
NEXT_PUBLIC_SITE_URL=https://tangle.kr

# Image upload and external AI processing are disabled in this version.

# 탱글 × 닥터에이디 파트너 배너의 공식몰 링크 (비우면 "오픈 준비 중" 표시)
NEXT_PUBLIC_DRAIDEE_SHOP_URL=
