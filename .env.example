# Copy to .env.local and fill values (never commit .env.local)

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI (server routes: chat / recommend / image-consult)
OPENAI_API_KEY=

# Optional — Kakao channel CTA (set on Vercel Production/Preview)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 사이트맵/메타데이터에 쓰이는 프로덕션 도메인
NEXT_PUBLIC_SITE_URL=https://tangle-2.vercel.app

# Optional — external image consult endpoint
# CNN_IMAGE_CONSULT_URL=
