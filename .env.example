# Copy to .env.local and fill values (never commit .env.local)

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 탱글 AI (챗봇·질문지·후기 체크·번역). 키가 없거나 크레딧이 없으면 저장 자료 기반 기본 안내로 동작합니다.
OPENAI_API_KEY=
# 기본 gpt-5.4-mini
OPENAI_MODEL=
# off로 두면 외부 AI 호출을 끕니다.
TANGLE_AI=

# Enable only after DB ownership/RLS review. Defaults to disabled.
QUOTE_WORKFLOW_ENABLED=false

# Optional — Kakao channel CTA (set on Vercel Production/Preview)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
# 사이트맵/메타데이터에 쓰이는 프로덕션 도메인
NEXT_PUBLIC_SITE_URL=https://tangle.kr

# 사진 업로드·사진 분석은 이 버전에서 제공하지 않습니다.

# 탱글 × 닥터에이디 파트너 배너의 공식몰 링크 (비우면 https://doctoraidee.com)
NEXT_PUBLIC_DRAIDEE_SHOP_URL=
